# ==========================================
# REQUIRED SECRETS
# ==========================================
# (None! The app runs entirely on keyless fallbacks out of the box.)

# ==========================================
# OPTIONAL LLM PROVIDERS
# ==========================================
# Groq ( llama-3.3-70b-versatile )
# URL: https://console.groq.com/keys
# Limit: Generous free tier
GROQ_API_KEY=

# Cerebras ( llama-3.3-70b )
# URL: https://cloud.cerebras.ai
# Limit: Free tier, very fast
CEREBRAS_API_KEY=

# Google Gemini ( gemini-2.0-flash )
# URL: https://aistudio.google.com/app/apikey
# Limit: Generous free tier (1500 RPD)
GEMINI_API_KEY=

# OpenRouter
# URL: https://openrouter.ai/keys
# Limit: Varies, supports :free models
OPENROUTER_API_KEY=

# ==========================================
# OPTIONAL IMAGE SOURCES
# ==========================================
# Pexels
# URL: https://www.pexels.com/api/new/
# Limit: 200 requests/hour
PEXELS_API_KEY=

# Pixabay
# URL: https://pixabay.com/api/docs/#api_key
# Limit: Generous free limits
PIXABAY_API_KEY=

# Unsplash
# URL: https://unsplash.com/developers
# Limit: 50 requests/hour demo rate
UNSPLASH_ACCESS_KEY=

# Openverse (OAuth Client)
# URL: https://api.openverse.engineering/v1/auth_tokens/register/
# Limit: Increases default rate limits substantially
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
